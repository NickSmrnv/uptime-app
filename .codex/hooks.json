{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "apply_patch|Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"$(git rev-parse --show-toplevel)/.codex/hooks/protect-committed-migrations.sh\"",
                        "statusMessage": "Checking committed migrations"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "apply_patch|Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": ".codex/hooks/gofmt.sh"
                    },
                    {
                        "type": "command",
                        "command": ".codex/hooks/eslint.sh"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "osascript -l JavaScript -e 'ObjC.import(\"Cocoa\"); var n=$.NSUserNotification.alloc.init; n.title=\"Codex\"; n.informativeText=\"Задача Codex завершена\"; $.NSUserNotificationCenter.defaultUserNotificationCenter.deliverNotification(n);'",
                        "timeout": 3
                    }
                ]
            }
        ]
    }
}
